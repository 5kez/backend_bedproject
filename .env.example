# Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=changeme
DB_DATABASE=8bits

# Application Configuration
BASE_URL=http://localhost:3000
PORT=3000
NODE_ENV=development
UPLOAD_PATH=uploads

# Auth / JWT
JWT_SECRET=changeme-generate-a-long-random-string
JWT_EXPIRES_IN=24h

# Swagger
SWAGGER_PATH=api/docs
ENABLE_SWAGGER=true

# CORS
CORS_ORIGIN=http://localhost:9000
CORS_METHODS=GET,HEAD,PUT,PATCH,POST,DELETE
CORS_ALLOWED_HEADERS=Content-Type, Authorization

# MQTT
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_CLIENT_ID=bed-sensor-backend
MQTT_USERNAME=changeme
MQTT_PASSWORD=changeme

# LLM / AI
GEMINI_API_KEY=changeme
OLLAMA_URL=http://127.0.0.1:11434/api/generate

# --- Docker Compose only (local mysql/mosquitto containers) ---
# Not used by the app directly; docker-compose.yml wires DB_HOST/DB_USERNAME/
# DB_PASSWORD/DB_DATABASE for the "app" service to these automatically so it
# talks to the containers below instead of whatever DB_HOST is set to above.
MYSQL_ROOT_PASSWORD=changeme-generate-a-long-random-string
MYSQL_DATABASE=8bits
MYSQL_USER=app_user
MYSQL_PASSWORD=changeme-generate-a-long-random-string
